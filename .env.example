# Copy this file to .env and fill it in. .env is ignored by git and must never be committed.
# Only needed for running the SQL files from a terminal with psql (see README).
# Use the "Session pooler" connection string from Supabase: Connect > Session pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<your-database-password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres"
